# OpenTab Agent Configuration
# ==============================================================================
# Model Provider: 'ollama', 'groq', or 'gemini'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Free Cloud API Keys (Optional - fast cloud reasoning with zero cost)
# Groq: Free tier with Llama 3.3 70B -> https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: Free tier -> https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Messaging Channels
# ------------------------------------------------------------------------------
# 1. Telegram (100% Free - Get token instantly from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM=True

# 2. WhatsApp (100% Free local QR code bridge)
ENABLE_WHATSAPP=True
WHATSAPP_PORT=3001
WHATSAPP_WEBHOOK_URL=http://localhost:8000/webhook/whatsapp

# Browser Automation (Playwright)
# ------------------------------------------------------------------------------
BROWSER_HEADLESS=True
BROWSER_TIMEOUT_MS=30000

# Integrations (Optional)
# ------------------------------------------------------------------------------
# Composio Tool Hub -> https://composio.dev (Free tier)
COMPOSIO_API_KEY=

# Security & Approval Threshold
# Sensitive actions (financial forms, irreversible deletions, booking submissions)
REQUIRE_APPROVAL_FOR_SENSITIVE=True
